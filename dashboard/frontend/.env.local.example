# ── Konfigurasi frontend dashboard ──
# Salin ke .env.local dan sesuaikan.

# Base URL backend FastAPI (mis. HF Spaces). Kosongkan untuk MODE MOCK (default).
NEXT_PUBLIC_API_BASE_URL=

# Paksa mock walau API base diset (true|false).
# Default: mock aktif otomatis bila NEXT_PUBLIC_API_BASE_URL kosong.
NEXT_PUBLIC_USE_MOCK=true
